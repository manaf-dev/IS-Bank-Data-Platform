		summarizeBy: none
		sourceColumn: applicant_monthly_income

	column employer_type
		dataType: string
		lineageTag: 407a0b91-8629-4dff-93db-0fa63d09920d
		summarizeBy: none
		sourceColumn: employer_type

	column bureau_score
		dataType: int64
		formatString: 0
		lineageTag: 4156288c-a7fc-49f5-8699-eaabb2c24aa1
		summarizeBy: none
		sourceColumn: bureau_score

	column loan_status
		dataType: string
		lineageTag: 577d7750-736e-4499-a97b-71adcffe83df
		summarizeBy: none
		sourceColumn: loan_status

	partition fact_loan = entity
		mode: directLake
		source
			entityName: fact_loan
			schemaName: dbo
			expressionSource: DatabaseQuery

