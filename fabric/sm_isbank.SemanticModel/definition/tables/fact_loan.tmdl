		summarizeBy: none
		sourceColumn: amount_repaid

	column last_missed_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 4434ec33-672f-421b-883f-a7685230bba6
		summarizeBy: none
		sourceColumn: last_missed_date

	column applicant_monthly_income
		dataType: decimal
		formatString: #,0.00
