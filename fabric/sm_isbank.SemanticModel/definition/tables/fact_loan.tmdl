		summarizeBy: none
		sourceColumn: term_months

	column instalments_due
		dataType: int64
		formatString: 0
		lineageTag: e1d6535b-2278-45f1-b8ba-0c3d0649579c
		summarizeBy: none
		sourceColumn: instalments_due

	column instalments_missed
		dataType: int64
