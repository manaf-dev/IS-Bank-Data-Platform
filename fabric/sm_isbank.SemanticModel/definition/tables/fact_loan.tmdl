/// Loan book snapshot as of 2025-12-31. Disbursal date relationship is inactive.
table fact_loan
	lineageTag: 80f76a2e-5aba-4a6a-b884-f57e147c42dc

	measure Loans = COUNTROWS ( fact_loan )
		formatString: #,0
		displayFolder: Loan Book
		lineageTag: 41be5c1e-0d49-4c1d-add8-8931fe1f3693

	measure 'Loan Principal' = SUM ( fact_loan[principal] )
		formatString: #,0.00
		displayFolder: Loan Book
		lineageTag: b8f3d92e-4b6c-4b48-a9ee-819d0811597a

	measure 'Amount Repaid' = SUM ( fact_loan[amount_repaid] )
		formatString: #,0.00
		displayFolder: Loan Book
		lineageTag: 93adbf7b-98ea-4331-af1c-22017496ceed

	measure 'Open Loans' = CALCULATE ( [Loans], fact_loan[loan_status] IN { "PERFORMING", "ARREARS", "DEFAULT" } )
		formatString: #,0
		displayFolder: Loan Book
		lineageTag: c29ec68f-4ed3-46e0-9708-4fba94e11d94

	measure 'Defaulted Loans' = CALCULATE ( [Loans], fact_loan[loan_status] = "DEFAULT" )
		formatString: #,0
		displayFolder: Loan Book
		lineageTag: 5648a05a-14bc-43e4-ab7a-bbc09de2998f

	measure 'NPL Ratio' =
			-- Non-performing (arrears or default) principal over the open book.
			DIVIDE (
			    CALCULATE ( [Loan Principal], fact_loan[loan_status] IN { "ARREARS", "DEFAULT" } ),
			    CALCULATE ( [Loan Principal], fact_loan[loan_status] IN { "PERFORMING", "ARREARS", "DEFAULT" } )
			)
		formatString: 0.0%
		displayFolder: Loan Book
		lineageTag: d9947862-4d18-416c-952a-7466f84709c9

	measure 'Default Rate' = DIVIDE ( [Defaulted Loans], [Loans] )
		formatString: 0.0%
		displayFolder: Loan Book
		lineageTag: 8e52951f-e8df-451b-9b06-26c9497a7f7a

	measure 'Avg Bureau Score' = AVERAGE ( fact_loan[bureau_score] )
		formatString: 0
		displayFolder: Loan Book
		lineageTag: 9e53fc3f-2e8f-4cc4-9752-9a754d490309

	measure 'Loans Disbursed' = CALCULATE ( [Loans], USERELATIONSHIP ( fact_loan[disbursed_date_key], dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Loan Book
		lineageTag: 983db720-958e-4227-b24d-f82a7de5a3f7

	column account_key
		dataType: int64
		isHidden
		lineageTag: 2ab099fb-d478-4de2-ba82-de31ab5df467
		summarizeBy: none
		sourceColumn: account_key

	column customer_key
		dataType: int64
		isHidden
		lineageTag: f7ca98f9-7364-4443-bf83-b9baa23c807b
		summarizeBy: none
		sourceColumn: customer_key

	column product_key
