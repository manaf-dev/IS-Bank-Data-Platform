table dim_date
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column month_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_key

	column day_of_month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_month

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column is_month_end
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_month_end

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DatabaseQuery

