table fact_card_transaction
	lineageTag: a389e349-3db7-4589-aaaf-655af27a6dab

	measure 'Card Transactions' = COUNTROWS ( fact_card_transaction )
		formatString: #,0
		displayFolder: Cards
		lineageTag: 57d7a9ba-7dcc-411b-a2ed-afb5ad4b46c3

	measure 'Card Value' = SUM ( fact_card_transaction[amount] )
		formatString: #,0.00
		displayFolder: Cards
		lineageTag: e03cbba0-283d-4f3d-8654-396538211949

	measure 'Card Decline Rate' = DIVIDE ( CALCULATE ( [Card Transactions], fact_card_transaction[is_approved] = FALSE () ), [Card Transactions] )
		formatString: 0.0%
		displayFolder: Cards
		lineageTag: cbc479a3-9005-44fa-93cf-f142d38b390b

	measure 'Night-time Share' = DIVIDE ( CALCULATE ( [Card Transactions], fact_card_transaction[is_night] = TRUE () ), [Card Transactions] )
		formatString: 0.0%
		displayFolder: Fraud Signals
		lineageTag: 1bc1a71f-01bb-44a3-8ffc-ae45087acfb2

	measure 'Night-time Card Value' = CALCULATE ( [Card Value], fact_card_transaction[is_night] = TRUE () )
		formatString: #,0.00
		displayFolder: Fraud Signals
		lineageTag: d7be58f3-17d6-4ee0-b049-d9a4373d25e5

	measure 'Card-testing Alerts' =
			-- Card-days with 5+ probes of GHS 10 or less: the classic test-then-cash-out pattern.
			VAR Probes =
			    SUMMARIZE (
			        FILTER ( fact_card_transaction, fact_card_transaction[amount] <= 10 ),
			        fact_card_transaction[account_key],
			        fact_card_transaction[date_key]
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            Probes,
			            CALCULATE ( [Card Transactions], fact_card_transaction[amount] <= 10 ) >= 5
			        )
			    )
		formatString: #,0
		displayFolder: Fraud Signals
		lineageTag: 3897f096-ca8c-47ca-b42a-d6a18a174551

	measure 'E-commerce Share' = DIVIDE ( CALCULATE ( [Card Transactions], fact_card_transaction[entry_mode] = "ECOMMERCE" ), [Card Transactions] )
		formatString: 0.0%
		displayFolder: Cards
		lineageTag: 9d15803b-b980-4fac-b3fc-16fed3f85932

