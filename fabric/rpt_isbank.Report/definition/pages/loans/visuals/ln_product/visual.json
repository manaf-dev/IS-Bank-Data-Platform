                  "Property": "product_name"
                }
              },
              "queryRef": "dim_product.product_name",
              "nativeQueryRef": "product_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_loan"
                    }
                  },
                  "Property": "Loan Principal"
                }
              },
              "queryRef": "fact_loan.Loan Principal",
              "nativeQueryRef": "Loan Principal"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true
