{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "pr_recon",
  "position": {
    "x": 790,
    "y": 450,
    "z": 10,
    "height": 260,
    "width": 470,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_branch"
                    }
                  },
                  "Property": "branch_name"
                }
              },
              "queryRef": "dim_branch.branch_name",
              "nativeQueryRef": "branch_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "recon_gl_fees"
                    }
                  },
                  "Property": "Reconciliation Breaks"
                }
              },
              "queryRef": "recon_gl_fees.Reconciliation Breaks",
              "nativeQueryRef": "Reconciliation Breaks"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}