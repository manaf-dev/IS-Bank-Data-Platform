                  "Property": "month_key"
                }
              },
              "queryRef": "dim_date.month_key",
              "nativeQueryRef": "month_key",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_gl_entry"
                    }
                  },
                  "Property": "Net Profit"
                }
              },
              "queryRef": "fact_gl_entry.Net Profit",
              "nativeQueryRef": "Net Profit"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}