        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_transaction"
                    }
                  },
                  "Property": "At-risk Rate"
                }
              },
              "queryRef": "fact_transaction.At-risk Rate",
              "nativeQueryRef": "At-risk Rate"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true
