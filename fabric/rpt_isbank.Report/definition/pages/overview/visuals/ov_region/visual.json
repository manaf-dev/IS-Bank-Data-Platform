                  "Property": "region"
                }
              },
              "queryRef": "dim_branch.region",
              "nativeQueryRef": "region",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_account_balance_monthly"
                    }
                  },
                  "Property": "Deposits"
                }
              },
              "queryRef": "fact_account_balance_monthly.Deposits",
              "nativeQueryRef": "Deposits"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}