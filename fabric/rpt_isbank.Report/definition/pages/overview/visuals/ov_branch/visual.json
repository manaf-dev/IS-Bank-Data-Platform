                }
              },
              "queryRef": "dim_branch.branch_name",
              "nativeQueryRef": "branch_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_gl_entry"
                    }
                  },
                  "Property": "Net Profit"
                }
              },
              "queryRef": "fact_gl_entry.Net Profit",
              "nativeQueryRef": "Net Profit"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
