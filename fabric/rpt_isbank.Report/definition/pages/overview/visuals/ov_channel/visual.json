{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "ov_channel",
  "position": {
    "x": 650,
    "y": 460,
    "z": 12,
    "height": 250,
    "width": 610,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_channel"
                    }
                  },
                  "Property": "channel"
                }
              },
              "queryRef": "dim_channel.channel",
              "nativeQueryRef": "channel",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_transaction"
                    }
                  },
                  "Property": "Transactions"
                }
              },
              "queryRef": "fact_transaction.Transactions",
              "nativeQueryRef": "Transactions"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}