EVALUATE
SUMMARIZECOLUMNS (
    ROLLUPADDISSUBTOTAL ( ROLLUPGROUP ( 'dim_branch'[branch_name] ), "IsGrandTotal" ),
    "Income", [Income],
    "Expense", [Expense],
    "Net Profit", [Net Profit],
    "Cost-to-Income Ratio", [Cost-to-Income Ratio],
    "Profit Margin", [Profit Margin]
)
ORDER BY [IsGrandTotal], 'dim_branch'[branch_name]
