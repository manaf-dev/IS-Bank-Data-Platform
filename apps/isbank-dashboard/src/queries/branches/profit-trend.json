{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "transform": [{ "calculate": "datetime(datum.Year, datum.Month - 1, 1)", "as": "MonthStart" }],
  "encoding": {
    "x": { "field": "MonthStart", "type": "temporal", "timeUnit": "yearmonth", "title": null }
  },
  "layer": [
    { "mark": { "type": "rule", "strokeDash": [4, 4] }, "encoding": { "y": { "datum": 0 }, "x": null } },
    {
      "mark": "line",
      "encoding": {
        "y": { "field": "NetProfit", "type": "quantitative", "title": null },
        "tooltip": [
          { "field": "MonthStart", "type": "temporal", "timeUnit": "yearmonth", "title": "Month" },
          { "field": "NetProfit", "type": "quantitative" }
        ]
      }
    }
  ]
}
